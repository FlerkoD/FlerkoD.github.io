# ─────────────────────────────────────────────────────────────
# Скопируйте этот файл в .env и при необходимости поправьте значения:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Нужен ТОЛЬКО для онлайн-режима (комнаты по коду).
# Все остальные режимы игры работают без базы данных.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Онлайн-режим: 1 — включён (нужен сервер + база), 0 — выключен.
# Для сборки под GitHub Pages ставится 0 автоматически.
NEXT_PUBLIC_ONLINE=0
